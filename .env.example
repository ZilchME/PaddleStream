# PaddleStream web server
PADDLESTREAM_WEB_HOST=0.0.0.0
PADDLESTREAM_WEB_PORT=8008

# Optional project root override
# PADDLESTREAM_PROJECT_DIR=/absolute/path/to/PaddleStream

# PaddleSpeech ASR
PADDLESTREAM_ASR_SERVER_IP=127.0.0.1
PADDLESTREAM_ASR_SERVER_PORT=8090
PADDLESTREAM_ASR_SERVER_ENDPOINT=/paddlespeech/asr/streaming

# PaddleSpeech TTS
PADDLESTREAM_TTS_SERVER_IP=127.0.0.1
PADDLESTREAM_TTS_SERVER_PORT=8090
PADDLESTREAM_TTS_SERVER_ENDPOINT=/paddlespeech/tts/streaming

# Punctuation service
PADDLESTREAM_PUNC_SERVER_IP=127.0.0.1
PADDLESTREAM_PUNC_SERVER_PORT=8190

# LLM SSE endpoint
PADDLESTREAM_LLM_API_URL=http://127.0.0.1:48080/stream
PADDLESTREAM_LLM_API_TIMEOUT=120

# Shared sync request timeout
PADDLESTREAM_SYNC_HTTP_TIMEOUT_SECONDS=10

# Runtime correction config path
PADDLESTREAM_CORRECTION_CONFIG_PATH=data/correction_config.json
